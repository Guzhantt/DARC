# Only required when execution.mode == "live" in config.yaml.
# Copy this file to .env and fill in real values.

# Polygon EOA private key holding USDC + MATIC for gas.
POLYGON_PRIVATE_KEY=

# Polymarket CLOB API credentials. Generate with py-clob-client's create_or_derive_api_creds.
CLOB_API_KEY=
CLOB_SECRET=
CLOB_PASSPHRASE=
