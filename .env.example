# Copy this file to `.env` and fill in your keys.
# NEVER commit the real .env file.

# Binance API credentials
# For testnet, register at: https://testnet.binancefuture.com
BINANCE_API_KEY=your_api_key_here
BINANCE_API_SECRET=your_api_secret_here

# true = use Binance Futures Testnet (SAFE, fake money)
# false = use real Binance Futures (REAL money, BE CAREFUL)
USE_TESTNET=true

# Risk parameters
RISK_PER_TRADE=0.01          # risk 1% of equity per trade
MAX_LEVERAGE=3               # max leverage to use (keep low!)
MAX_DAILY_DRAWDOWN=0.05      # stop trading if daily loss > 5%
MAX_OPEN_POSITIONS=3
