# =========================================
#  Binance Futures Bot v2 - 配置
# =========================================
# 复制此文件为 .env 并填入你的密钥
# cp .env.example .env

# === 必填 ===
BINANCE_API_KEY=your_api_key_here
BINANCE_API_SECRET=your_api_secret_here

# === 模式选择 ===
# true = Testnet (假钱, 强烈推荐先用这个跑 2 周)
# false = 实盘 (真钱, 风险极高)
USE_TESTNET=true

# === 风控 (强烈建议保持默认或更保守) ===
RISK_PER_TRADE=0.01          # 每笔最大风险 1% (实盘建议 0.005)
MAX_LEVERAGE=2               # 杠杆 2x (实盘建议 1-2x, 不要 5x+)
MAX_DAILY_DRAWDOWN=0.05      # 日内回撤 5% 自动熔断
MAX_OPEN_POSITIONS=3         # 最多同时持仓数
MAX_PCT_PER_SYMBOL=0.30      # 单币最多占总资金 30%

# === 策略参数 ===
TIMEFRAME=1h                 # K 线周期: 15m | 1h | 4h
SCAN_INTERVAL=300            # 扫描间隔 (秒), 5分钟一次
MIN_VOLUME_M=10              # 最小 24h 成交量 (百万 USDT)
COOLDOWN_HOURS=4             # 同币种交易冷却时间

# === 鲸鱼过滤器 ===
# VETO    - 鲸鱼明显反向就否决信号 (减少 30% 交易)
# CONFIRM - 必须鲸鱼正向才入场 (高胜率, 交易少)
# SIZE    - 根据鲸鱼分数动态调仓 (推荐, 平衡)
# DISABLED- 关闭过滤器
WHALE_FILTER_MODE=SIZE

# === 心跳监控 ===
HEARTBEAT_INTERVAL=1800      # 心跳检查间隔 (30分钟)
HEARTBEAT_TIMEOUT=3600       # 超时阈值 (1小时)

# === Telegram 通知 (可选, 强烈推荐) ===
# 1. 找 @BotFather 创建一个 bot, 拿 token
# 2. 给你的 bot 发任意消息, 然后访问:
#    https://api.telegram.org/bot<TOKEN>/getUpdates 获取 chat_id
TG_BOT_TOKEN=
TG_CHAT_ID=

# === 文件路径 ===
BOT_DB_FILE=bot_state.db
BOT_LOG_FILE=bot.log
